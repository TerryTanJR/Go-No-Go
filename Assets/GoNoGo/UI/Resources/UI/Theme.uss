/* Go/No-Go 任務控制中心主題。顏色：
   底 #070B14、面板 rgba(10,18,32,0.86)、框線 #1F3550、主色 #39C6F4、
   GO #3DDC84、緊 #FFB547、超標 #FF4D5E、文字 #E6EEF8、次要 #8BA3BF
   字級：40px 以下一律寫 var(--fs-N)（N = 預設大小的像素），玩家的「字體大小」設定才調得到；
   各檔大小在 FontScale.uss（GoNoGo/Build/UI Font Scale 自動產生）。
   裝文字的框不要用固定 width/height，用 min-width/min-height 或讓它換行，放大字體才不會被切掉。 */

:root {
    --c-bg: #070B14;
    --c-panel: rgba(10, 18, 32, 0.86);
    --c-panel-solid: #0B1424;
    --c-line: #1F3550;
    --c-line-hi: #2E5478;
    --c-accent: #39C6F4;
    --c-accent-dim: rgba(57, 198, 244, 0.18);
    --c-go: #3DDC84;
    --c-tight: #FFB547;
    --c-over: #FF4D5E;
    --c-text: #E6EEF8;
    --c-dim: #8BA3BF;
    --c-faint: #4D6580;
    color: var(--c-text);
    font-size: var(--fs-15);
    -unity-font-definition: url("project://database/Assets/GoNoGo/UI/Resources/UI/Fonts/Latin.asset");
}

.screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- 文字 ---------- */
.h1 { font-size: 64px; -unity-font-style: bold; letter-spacing: 6px; color: var(--c-text); }
.h2 { font-size: var(--fs-26); -unity-font-style: bold; letter-spacing: 2px; }
.h3 { font-size: var(--fs-18); -unity-font-style: bold; letter-spacing: 1px; }
.eyebrow { font-size: var(--fs-12); letter-spacing: 3px; color: var(--c-accent); -unity-font-style: bold; }
.dim { color: var(--c-dim); }
.faint { color: var(--c-faint); }
.mono { -unity-font-definition: url("project://database/Assets/GoNoGo/UI/Resources/UI/Fonts/Mono.asset"); }
.small { font-size: var(--fs-12); }
.body { white-space: normal; font-size: var(--fs-15); color: var(--c-dim); }
.go { color: var(--c-go); }
.tight { color: var(--c-tight); }
.over { color: var(--c-over); }
.accent { color: var(--c-accent); }

/* 用 .unity-label（不是 Label 型別選擇器）：預設主題的 .unity-label 是類別選擇器、優先權較高，型別選擇器蓋不過它 */
.unity-label { white-space: normal; padding: 0; margin: 0; }

/* ---------- 面板 ---------- */
.panel {
    background-color: var(--c-panel);
    border-width: 1px;
    border-color: var(--c-line);
    border-radius: 6px;
    padding: 14px 16px;
}
.panel-title {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--c-line);
}
.row { flex-direction: row; align-items: center; }
/* 一列裡的文字：Label 預設不會縮，列太長時會把旁邊的東西擠出框外。讓文字可以縮（自動換行），
   只有在放不下時才會發生，平常版面不變。數字（.mono）和不換行的標籤維持原寬。 */
.row > .unity-label { flex-shrink: 1; }
.row > .mono, .row > .eyebrow { flex-shrink: 0; }
.spacer { flex-grow: 1; }

/* ---------- 按鈕 ---------- */
/* 用 .unity-button 而不是 Button 型別選擇器：預設主題的 .unity-button（含 :hover:enabled 等）優先權較高，
   型別選擇器會被蓋掉，按鈕就變回 Unity 預設的灰底。hover/active 也同時寫 :enabled 版本，優先權才追得上。 */
.unity-button {
    background-color: rgba(57, 198, 244, 0.08);
    border-width: 1px;
    border-color: var(--c-line-hi);
    border-radius: 4px;
    color: var(--c-text);
    padding: 8px 16px;
    margin: 0;
    font-size: var(--fs-15);
    -unity-font-style: bold;
    letter-spacing: 1px;
    transition-duration: 0.15s;
}
.unity-button:hover, .unity-button:hover:enabled {
    background-color: rgba(57, 198, 244, 0.22);
    border-color: var(--c-accent);
    scale: 1.02 1.02;
}
.unity-button:active, .unity-button:active:enabled { scale: 0.98 0.98; background-color: rgba(57, 198, 244, 0.3); }
.unity-button:disabled { opacity: 0.35; }
.unity-button:focus { border-color: var(--c-line-hi); }
.btn-primary {
    background-color: rgba(57, 198, 244, 0.85);
    border-color: #8BE3FF;
    color: #04121D;
}
.btn-primary:hover, .btn-primary:hover:enabled, .btn-primary:active:enabled { background-color: #6BD8FF; }
.btn-go { background-color: rgba(61, 220, 132, 0.85); border-color: #9BF2C2; color: #03170B; }
.btn-go:hover, .btn-go:hover:enabled, .btn-go:active:enabled { background-color: #5FF09E; }
.btn-danger { background-color: rgba(255, 77, 94, 0.15); border-color: var(--c-over); }
.btn-danger:hover, .btn-danger:hover:enabled { background-color: rgba(255, 77, 94, 0.3); }
.btn-ghost { background-color: rgba(0, 0, 0, 0); border-color: rgba(0, 0, 0, 0); color: var(--c-dim); }
.btn-ghost:hover, .btn-ghost:hover:enabled { color: var(--c-text); background-color: rgba(255, 255, 255, 0.06); border-color: rgba(0, 0, 0, 0); }
.btn-big { font-size: var(--fs-22); padding: 14px 34px; letter-spacing: 3px; }
.btn-small { font-size: var(--fs-12); padding: 4px 10px; }
.chip {
    padding: 4px 10px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--c-line-hi);
    font-size: var(--fs-12);
    margin-right: 6px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-dim);
}
.chip:hover, .chip:hover:enabled { background-color: rgba(57, 198, 244, 0.12); border-color: var(--c-accent); color: var(--c-text); scale: 1 1; }
.chip--on, .chip--on:hover:enabled { background-color: var(--c-accent-dim); border-color: var(--c-accent); color: var(--c-text); }

/* ---------- 頂部列 ---------- */
.topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    min-height: 56px;
    flex-direction: row;
    align-items: center;
    padding: 0 20px;
    background-color: rgba(5, 9, 18, 0.82);
    border-bottom-width: 1px;
    border-color: var(--c-line);
}
.topbar .brand { font-size: var(--fs-20); -unity-font-style: bold; letter-spacing: 4px; color: var(--c-text); margin-right: 18px; }
.topbar .mission { color: var(--c-dim); font-size: var(--fs-14); }

/* ---------- 規格列（報告的真實任務卡） ---------- */
.part-stats { flex-direction: row; flex-wrap: wrap; margin-top: 4px; }
.part-stat { font-size: var(--fs-12); color: var(--c-dim); margin-right: 10px; }

/* ---------- 任務需求卡（報告） ---------- */
.req-card {
    padding: 10px 12px;
    border-radius: 5px;
    border-left-width: 3px;
    border-color: var(--c-tight);
    background-color: rgba(255, 181, 71, 0.08);
    margin-bottom: 8px;
}
.req-card--met { border-color: var(--c-go); background-color: rgba(61, 220, 132, 0.08); }

/* ---------- 報告 ---------- */
.stamp {
    font-size: 140px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 220px;
    height: 220px;
    border-width: 6px;
    border-radius: 18px;
    border-color: var(--c-go);
    color: var(--c-go);
    rotate: -8deg;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-back;
}
.stamp--hidden { scale: 2.6 2.6; opacity: 0; }
.stamp--fail { border-color: var(--c-over); color: var(--c-over); font-size: 64px; }
.stamp--b { border-color: var(--c-accent); color: var(--c-accent); }
.stamp--c { border-color: var(--c-tight); color: var(--c-tight); }

.score-row { flex-direction: row; align-items: center; margin-bottom: 10px; }
.score-name { min-width: 140px; flex-shrink: 0; margin-right: 8px; color: var(--c-dim); }
.score-track { flex-grow: 1; height: 8px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.06); }
.score-fill { height: 8px; border-radius: 4px; background-color: var(--c-accent); width: 0; transition-duration: 0.8s; transition-timing-function: ease-out-cubic; }
.score-num { min-width: 48px; -unity-text-align: middle-right; -unity-font-style: bold; }

.chain {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 10px 12px;
    margin-bottom: 8px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.03);
    border-left-width: 3px;
    border-color: var(--c-over);
}
.chain-step { font-size: var(--fs-14); white-space: normal; max-width: 300px; }
.chain-arrow { color: var(--c-accent); margin: 0 8px; font-size: var(--fs-16); }

/* ---------- 共用 ---------- */
.fader { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: #000000; opacity: 0; transition-duration: 0.45s; }
.fader--on { opacity: 1; }
/* 進場過場：火箭進度條 */
.loading {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: #03060C;
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.3s;
}
.loading--out { opacity: 0; transition-duration: 0.5s; }
.loading-col { width: 640px; }
.loading-title { font-size: var(--fs-26); letter-spacing: 6px; -unity-font-style: bold; color: var(--c-text); margin-bottom: 28px; }
.loading-track {
    height: 8px;
    border-radius: 4px;
    background-color: rgba(57, 198, 244, 0.15);
    overflow: visible;
}
.loading-fill { height: 8px; border-radius: 4px; background-color: var(--c-accent); }
.loading-rocket {
    position: absolute;
    top: 50%;
    width: 64px;
    height: 32px;
    translate: -85% -50%;
}
.loading-row { margin-top: 26px; align-items: center; }
.loading-stage { font-size: var(--fs-16); color: var(--c-dim); }
.loading-pct { font-size: var(--fs-16); color: var(--c-accent); }
.toast {
    position: absolute;
    left: 50%;
    top: 72px;
    translate: -50% 0;
    padding: 10px 18px;
    border-radius: 4px;
    background-color: rgba(10, 18, 32, 0.95);
    border-width: 1px;
    border-color: var(--c-accent);
    opacity: 0;
    transition-duration: 0.25s;
}
.toast--on { opacity: 1; }
/* 長的提示（裝錯小零件…）換行，不要橫跨到左上的引導卡和右上的組裝單 */
.toast { max-width: 44%; }
.toast > .small { white-space: normal; -unity-text-align: middle-center; }
.fade-in { opacity: 0; translate: 0 12px; transition-duration: 0.5s; transition-timing-function: ease-out-cubic; }
.fade-in--on { opacity: 1; translate: 0 0; }

ScrollView, .unity-scroll-view { flex-grow: 1; }
.unity-scroller--vertical { width: 6px; }
.unity-scroller--vertical .unity-base-slider__tracker { background-color: rgba(0, 0, 0, 0); border-width: 0; }
.unity-scroller--vertical .unity-base-slider__dragger { background-color: var(--c-line-hi); border-width: 0; border-radius: 3px; width: 6px; left: 0; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }

/* =====================================================================
   版面（參考解析度 1920x1080，PanelSettings 依螢幕縮放）
   ===================================================================== */
.app { flex-grow: 1; font-size: var(--fs-15); }
.panel-body { flex-grow: 1; flex-shrink: 1; }
.topbar--clear { background-color: rgba(0, 0, 0, 0); border-bottom-width: 0; }

/* ---------- 標題 ---------- */
.title-col { position: absolute; left: 120px; top: 120px; width: 900px; }
.title-logo { font-size: 128px; letter-spacing: 12px; margin: 4px 0 6px 0; }
.title-tagline { font-size: var(--fs-20); margin-bottom: 18px; max-width: 760px; color: var(--c-dim); }
.scn-card {
    width: 280px;
    margin-right: 14px;
    padding: 14px 16px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--c-line);
    background-color: rgba(10, 18, 32, 0.78);
    transition-duration: 0.15s;
}
.scn-card:hover, .scn-card:hover:enabled { border-color: var(--c-line-hi); background-color: rgba(20, 34, 58, 0.86); translate: 0 -2px; }
.scn-badge { font-size: var(--fs-11); letter-spacing: 2px; color: var(--c-tight); -unity-font-style: bold; margin-bottom: 6px; }
.scn-badge--plain { color: var(--c-accent); }
.scn-name { margin-bottom: 6px; }
.scn-desc { flex-grow: 1; margin-bottom: 10px; }
.scn-stats { color: var(--c-dim); }
.scn-dot { margin: 0 6px; }
.title-foot { position: absolute; left: 120px; right: 120px; bottom: 20px; }

/* ---------- 歷史關卡的揭曉（報告） ---------- */
.history-card { border-color: var(--c-tight); }
.history-sub { margin-top: 12px; margin-bottom: 4px; color: var(--c-tight); }
.history-verdict { margin-top: 12px; }
.history-sources { margin-top: 12px; }

/* ---------- 任務年數（選件面板的任務設定） ---------- */
.years-row { padding: 6px 0 10px 0; }
.years-value { min-width: 130px; -unity-text-align: middle-center; }

/* ---------- 發射 ---------- */
.launch-head { position: absolute; top: 70px; left: 0; right: 0; align-items: center; }
.launch-clock { font-size: 72px; letter-spacing: 4px; color: var(--c-text); margin-top: 6px; }
.launch-stage { font-size: var(--fs-24); letter-spacing: 3px; color: var(--c-accent); }
.launch-head .eyebrow { font-size: var(--fs-16); }
.launch-tele { position: absolute; left: 40px; bottom: 40px; width: 400px; }
.launch-tele .tele-k { font-size: var(--fs-18); }
.launch-tele .tele-u { font-size: var(--fs-16); }
.tele-row { margin: 4px 0; }
.tele-v { font-size: var(--fs-30); min-width: 130px; -unity-text-align: middle-right; }
.tele-u { min-width: 48px; margin-left: 6px; }
/* 播報：右下角淡入淡出，淡入淡出的時間要和 LaunchScreen.CallFadeMs 一致 */
.launch-calls { position: absolute; right: 40px; bottom: 40px; width: 560px; align-items: flex-end; }
.launch-call {
    font-size: var(--fs-26);
    padding: 8px 20px;
    margin-top: 6px;
    border-radius: 4px;
    background-color: rgba(5, 9, 18, 0.6);
    color: var(--c-text);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.35s;
}
.launch-call--on { opacity: 1; }
/* 結果卡片放在畫面下方：中間要留給衛星展開的鏡頭 */
.launch-outcome {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 120px;
    background-color: rgba(2, 4, 10, 0);
    transition-property: background-color;
    transition-duration: 1.2s;
}
.launch-outcome--dim { background-color: rgba(2, 4, 10, 0.45); }
/* 加速播放的倍率：時鐘右邊，接近原速時淡出 */
.launch-speed {
    position: absolute;
    top: 46px;
    left: 50%;
    margin-left: 240px;
    font-size: var(--fs-18);
    padding: 4px 10px;
    border-radius: 4px;
    color: var(--c-accent);
    background-color: rgba(5, 9, 18, 0.6);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
}
.launch-speed--on { opacity: 1; }
.outcome-card { width: 640px; padding: 26px 30px; }
.outcome-card .h2 { font-size: 40px; margin: 8px 0 12px 0; }
.outcome-actions { margin-top: 22px; }

/* ---------- 報告 ---------- */
.report-wrap { position: absolute; top: 72px; left: 20px; right: 20px; bottom: 96px; flex-direction: row; }
.report-col .panel { margin-bottom: 12px; }
.report-col--score { width: 480px; }
.report-col--why { flex-grow: 1; flex-basis: 0; margin: 0 16px; }
.report-col--why .panel { flex-grow: 1; flex-shrink: 1; }
.report-col--why .history-card { flex-grow: 0; }
.report-col--compare { width: 420px; flex-shrink: 0; }
.report-col--score { flex-shrink: 0; }
.report-col--why { min-width: 0; overflow: hidden; }
.stamp-row { align-items: center; margin-bottom: 8px; }
.total-box { margin-left: 26px; }
.total-num { font-size: 72px; letter-spacing: 0; }
.grade-desc { margin-bottom: 14px; }
.first-call { margin-top: 6px; }
.why-scroll { flex-grow: 1; }
.fact-row { margin-bottom: 6px; align-items: flex-start; }
.fact-k { width: 130px; flex-shrink: 0; }
.fact-v { flex-shrink: 1; }
.mission-card { padding: 10px 0; border-bottom-width: 1px; border-color: var(--c-line); }
.report-actions { position: absolute; left: 20px; right: 20px; bottom: 22px; }

/* ---------- 不換行的大數字 ----------
   .unity-label 預設改成可換行之後，固定寬度欄位裡的大數字（倒數時鐘、總分）會被折成兩行，這些要明確設成不換行 */
.launch-clock, .total-num, .title-logo, .tele-v, .eyebrow, .chip { white-space: nowrap; }

/* =====================================================================
   3D 版：主選單、Facility HUD、面板、世界螢幕
   ===================================================================== */

/* ---------- 標題 ---------- */
.title-click {
    margin-top: 40px;
    font-size: var(--fs-18);
    letter-spacing: 4px;
    color: var(--c-accent);
    -unity-font-style: bold;
    transition-property: opacity;
    transition-duration: 0.7s;
}
.title-click--dim { opacity: 0.35; }

/* ---------- 主選單 ---------- */
.menu-col {
    position: absolute;
    left: 72px;
    top: 96px;
    max-height: 82%;
    width: 560px;
    justify-content: flex-start;
    padding: 20px 22px;
    border-radius: 8px;
    background-color: rgba(4, 8, 16, 0.88);
    border-width: 1px;
    border-color: rgba(31, 53, 80, 0.7);
}
.menu-col--wide {
    left: 0;
    top: 48px;
    bottom: 0;
    width: 50%;
    max-height: none;
    border-radius: 0;
    border-left-width: 0;
    padding: 28px 56px 24px 72px;
}
.avatar-name { align-items: center; }
.avatar-name > .btn-small { margin-left: 10px; }
.avatar-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-bottom: 12px; }
.avatar-section { margin: 14px 0 8px 0; letter-spacing: 2px; }
.avatar-actions { margin-top: 4px; }
.opt-grid { flex-wrap: wrap; }
.opt-card {
    width: 132px;
    margin: 0 12px 12px 0;
    padding: 8px 6px 8px 6px;
    flex-direction: column;
    align-items: center;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--c-line);
    background-color: rgba(10, 22, 40, 0.8);
}
.opt-card:hover, .opt-card:hover:enabled { border-color: var(--c-accent); background-color: rgba(57, 198, 244, 0.12); }
.opt-card--on, .opt-card--on:hover:enabled { border-color: var(--c-accent); background-color: var(--c-accent-dim); }
.opt-img { width: 112px; height: 112px; -unity-background-scale-mode: scale-to-fit; }
.opt-label { margin-top: 4px; color: var(--c-text); -unity-text-align: middle-center; }
.swatch--big { width: 46px; height: 46px; min-width: 46px; border-radius: 23px; margin: 0 12px 12px 0; }
.menu-item {
    flex-direction: column;
    align-items: flex-start;
    margin: 0 0 10px 0;
    padding: 14px 18px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 3px;
    border-left-color: var(--c-accent);
    background-color: var(--c-panel);
    -unity-text-align: middle-left;
}
.menu-item:hover, .menu-item:hover:enabled {
    background-color: rgba(57, 198, 244, 0.12);
    border-color: var(--c-accent);
    translate: 6px 0;
}
.menu-item > .unity-label { margin-top: 2px; }
.menu-back { align-self: flex-start; margin: 0 0 14px -10px; }
.menu-sub { margin-top: 18px; }
.menu-error { margin-top: 10px; }
.menu-card { width: auto; margin-right: 0; margin-bottom: 10px; }
.menu-btn-gap { margin-right: 10px; }
.menu-desc { min-height: 44px; margin: 2px 0 10px 4px; white-space: normal; font-size: var(--fs-14); }
.menu-me { margin-top: 10px; padding: 6px 4px; }
.menu-me-name { font-size: var(--fs-22); -unity-font-style: bold; color: var(--c-text); }
.menu-avatar-hit {
    position: absolute;
    left: 62%;
    top: 26%;
    width: 24%;
    height: 56%;
}
.menu-avatar-btn {
    position: absolute;
    left: 73%;
    top: 84%;
    translate: -50% 0;
    padding: 12px 32px;
    border-radius: 24px;
    font-size: var(--fs-20);
    letter-spacing: 2px;
    color: var(--c-text);
    background-color: rgba(57, 198, 244, 0.18);
    border-width: 2px;
    border-color: var(--c-accent);
}
.menu-avatar-btn:hover, .menu-avatar-btn:hover:enabled, .menu-avatar-btn--hot {
    background-color: rgba(57, 198, 244, 0.85);
    border-color: #8BE3FF;
    color: #04121D;
}
.code-field { margin: 6px 0 10px 0; }
.code-field > .unity-text-field__input, .code-field .unity-base-text-field__input {
    background-color: rgba(4, 10, 20, 0.9);
    border-color: var(--c-line-hi);
    border-radius: 4px;
    color: var(--c-text);
    font-size: var(--fs-18);
    padding: 6px 10px;
}
.swatches { flex-wrap: wrap; margin: 4px 0 10px 0; }
.swatch {
    width: 34px;
    height: 34px;
    min-width: 34px;
    margin: 0 8px 8px 0;
    padding: 0;
    border-radius: 17px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
}
.swatch:hover, .swatch:hover:enabled { border-color: var(--c-text); }
.swatch--on, .swatch--on:hover:enabled { border-color: var(--c-accent); border-width: 3px; scale: 1.12 1.12; }
.tabs { flex-direction: row; margin: 8px 0 12px 0; border-bottom-width: 1px; border-color: var(--c-line); }
.tab {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: var(--c-dim);
    padding: 6px 14px;
    margin: 0 4px -1px 0;
}
.tab:hover, .tab:hover:enabled { color: var(--c-text); background-color: rgba(255, 255, 255, 0.04); border-color: rgba(0, 0, 0, 0); }
.tab--on, .tab--on:hover:enabled { color: var(--c-text); border-bottom-color: var(--c-accent); }

/* ---------- HUD ---------- */
.hud { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.hud-tl { position: absolute; left: 16px; top: 12px; }
.hud-tr { position: absolute; right: 14px; top: 10px; }
.hud-area { font-size: var(--fs-16); letter-spacing: 3px; color: var(--c-accent); -unity-font-style: bold; }
.hud-phase { margin-top: 6px; }
.hud-held {
    position: absolute;
    left: 50%;
    bottom: 28px;
    translate: -50% 0;
    padding: 6px 16px;
    border-radius: 16px;
    font-size: var(--fs-16);
    color: var(--c-text);
    background-color: rgba(6, 12, 22, 0.8);
    border-width: 1px;
    border-color: var(--c-accent);
}
.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 6px;
    height: 6px;
    translate: -3px -3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    transition-property: width, height, translate, border-radius, background-color;
    transition-duration: 0.12s;
}
.crosshair--on {
    width: 18px;
    height: 18px;
    translate: -9px -9px;
    border-radius: 9px;
    border-width: 2px;
    border-color: var(--c-accent);
    background-color: rgba(57, 198, 244, 0.15);
}
.hold-ring {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    translate: -32px -32px;
}
.info-box {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: 40px 24px;
    max-width: 380px;
    min-width: 220px;
    padding: 10px 14px;
    border-radius: 5px;
    background-color: rgba(6, 12, 22, 0.88);
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 3px;
    border-left-color: var(--c-accent);
}
.info-title { font-size: var(--fs-16); -unity-font-style: bold; color: var(--c-text); }
.info-body { font-size: var(--fs-13); color: var(--c-dim); white-space: normal; margin-top: 3px; }
.info-keys { margin-top: 8px; flex-wrap: wrap; }
.key-hint { flex-direction: row; align-items: center; margin-right: 14px; margin-top: 2px; }
.keycap {
    min-width: 22px;
    padding: 1px 6px;
    margin-right: 6px;
    border-radius: 4px;
    border-width: 1px;
    border-bottom-width: 3px;
    border-color: #9FB4CC;
    background-color: #E6EEF8;
    color: #0B1424;
    font-size: var(--fs-13);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}
.key-label { font-size: var(--fs-12); color: var(--c-text); }

/* 場景標籤 */
.world-labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.world-label {
    position: absolute;
    translate: -50% -100%;
    transform-origin: 50% 100%;
    padding: 3px 10px;
    border-radius: 3px;
    white-space: nowrap;
}
.world-label--sign {
    font-size: var(--fs-13);
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--c-text);
    background-color: rgba(6, 12, 22, 0.75);
    border-bottom-width: 2px;
    border-color: var(--c-accent);
}
/* 大廳拱門上的名稱：比一般看板大，從大廳另一頭也看得清楚 */
.world-label--team {
    font-size: var(--fs-26);
    letter-spacing: 4px;
    padding: 5px 16px;
    -unity-font-style: bold;
    color: var(--c-text);
    background-color: rgba(6, 12, 22, 0.75);
    border-bottom-width: 3px;
    border-color: var(--c-accent);
}
.world-label--tag { font-size: var(--fs-11); letter-spacing: 2px; color: var(--c-accent); background-color: rgba(6, 12, 22, 0.6); }

/* 小零件的名稱（零件架、組裝台）：中文字，要看得清楚（code 那種是等寬字型，只有英數字） */
.world-label--comp {
    font-size: var(--fs-13);
    -unity-font-style: bold;
    color: var(--c-text);
    background-color: rgba(6, 12, 22, 0.8);
    border-bottom-width: 1px;
    border-color: var(--c-accent);
    padding: 1px 6px;
}

/* ---------- 面板（按 E 打開） ---------- */
.modal-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(2, 5, 10, 0.55);
}
.modal {
    width: 640px;
    max-width: 92%;
    max-height: 88%;
    padding: 16px 20px;
    border-radius: 8px;
    background-color: rgba(9, 16, 28, 0.97);
    border-width: 1px;
    border-color: var(--c-line-hi);
    border-top-width: 3px;
    border-top-color: var(--c-accent);
}
.modal--wide { width: 1100px; }
.modal--narrow { width: 420px; }
.modal-head { flex-direction: row; align-items: center; margin-bottom: 10px; padding-bottom: 8px; border-bottom-width: 1px; border-color: var(--c-line); }
.modal-head .eyebrow { font-size: var(--fs-15); }
.modal-close {
    padding: 4px 12px;
    font-size: var(--fs-15);
    color: var(--c-dim);
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--c-line);
}
.modal-close:hover, .modal-close:hover:enabled { color: var(--c-text); border-color: var(--c-accent); }
.modal-body { flex-grow: 1; flex-shrink: 1; }
.modal-actions { flex-direction: row; align-items: center; margin-top: 16px; }
/* 遊戲選單（Tab / Esc） */
.game-menu-layer { background-color: rgba(2, 5, 10, 0.7); }
.game-menu { width: 560px; }
.gm-col { margin-top: 4px; }
.gm-col > * { margin-bottom: 10px; }
.gm-mission { margin-bottom: 10px; color: var(--c-text); }
.gm-key-row { flex-direction: row; align-items: center; padding: 5px 0; border-bottom-width: 1px; border-color: rgba(31, 53, 80, 0.5); }
.gm-keycap { min-width: 96px; margin-right: 16px; font-size: var(--fs-15); }
.gm-key-label { font-size: var(--fs-16); color: var(--c-text); }
.gm-btn { padding: 10px 16px; font-size: var(--fs-16); -unity-text-align: middle-center; }
.gm-row { flex-direction: row; align-items: center; min-height: 34px; }
.gm-label { width: 130px; flex-shrink: 0; color: var(--c-dim); white-space: normal; }
.gm-choices { flex-direction: row; flex-wrap: wrap; flex-grow: 1; }
.gm-value { min-width: 52px; flex-shrink: 0; -unity-text-align: middle-right; color: var(--c-text); }
.gm-actions { flex-direction: row; align-items: center; margin-top: 6px; }
.gm-slider { flex-grow: 1; margin: 0 10px 0 0; }
.gm-slider .unity-base-slider__tracker { background-color: var(--c-line); border-width: 0; border-radius: 2px; height: 4px; margin-top: -2px; }
.gm-slider .unity-base-slider__dragger { background-color: var(--c-accent); border-width: 0; border-radius: 8px; width: 16px; height: 16px; margin-top: -8px; }
.gm-slider .unity-base-slider__dragger-border { display: none; }
.code-chip {
    padding: 2px 8px;
    margin: 0 6px 6px 0;
    border-radius: 3px;
    background-color: rgba(57, 198, 244, 0.12);
    border-width: 1px;
    border-color: var(--c-line-hi);
    font-size: var(--fs-12);
    color: var(--c-text);
}

/* ---------- 任務簡報（BriefingPanel）：主任視訊交代任務 ---------- */
.modal--brief { width: 1500px; max-width: 96%; max-height: 94%; padding: 20px 26px; }
.brief-wrap { flex-direction: row; align-items: stretch; }
.brief-feed {
    width: 400px;
    flex-shrink: 0;
    margin-right: 24px;
    padding: 10px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--c-line-hi);
    background-color: #050A12;
}
.brief-feed-bar { flex-direction: row; align-items: center; margin-bottom: 8px; }
.brief-live { width: 12px; height: 12px; border-radius: 6px; background-color: var(--c-over); margin-right: 6px; }
.brief-live--off { background-color: var(--c-faint); }
.brief-live-text { font-size: var(--fs-14); color: var(--c-over); -unity-font-style: bold; letter-spacing: 2px; }
.brief-channel { font-size: var(--fs-13); color: var(--c-dim); letter-spacing: 1px; }
.brief-screen {
    height: 300px;
    border-radius: 6px;
    overflow: hidden;
    background-color: #0C1C30;
    border-width: 1px;
    border-color: #17304C;
    justify-content: space-between;
}
.brief-scan { height: 1px; background-color: rgba(120, 190, 255, 0.07); flex-shrink: 0; }
/* 主任肖像：貼著畫面底部，等比縮放 */
.brief-portrait {
    position: absolute;
    left: 0;
    right: 0;
    top: 22px;
    bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
    background-position-y: bottom;
}
.brief-figure { position: absolute; left: 0; right: 0; bottom: 0; height: 250px; align-items: center; justify-content: flex-end; }
.brief-head {
    width: 96px;
    height: 112px;
    border-radius: 48px;
    background-color: #1E3A5C;
    border-width: 2px;
    border-color: #2C527C;
    margin-bottom: -10px;
}
.brief-headset {
    position: absolute;
    bottom: 140px;
    width: 116px;
    height: 70px;
    border-top-left-radius: 58px;
    border-top-right-radius: 58px;
    border-top-width: 6px;
    border-left-width: 6px;
    border-right-width: 6px;
    border-color: #39C6F4;
    opacity: 0.85;
}
.brief-body {
    width: 250px;
    height: 120px;
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    background-color: #17314F;
    border-width: 2px;
    border-bottom-width: 0;
    border-color: #2C527C;
    align-items: center;
}
.brief-collar { width: 0; height: 0; margin-top: 4px; border-left-width: 30px; border-right-width: 30px; border-top-width: 46px; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: #DDE6F0; }
.brief-badge { position: absolute; left: 52px; top: 40px; width: 26px; height: 26px; border-radius: 13px; background-color: var(--c-tight); border-width: 3px; border-color: #FFD89A; }
.brief-rec { position: absolute; right: 10px; top: 8px; font-size: var(--fs-13); color: var(--c-over); }
.brief-id { margin-top: 10px; padding-left: 4px; }
.brief-name { font-size: var(--fs-22); -unity-font-style: bold; color: var(--c-text); }
.brief-wave { flex-direction: row; align-items: center; justify-content: space-between; height: 40px; margin-top: 10px; padding: 0 4px; }
.brief-wave-bar { width: 8px; height: 8%; border-radius: 3px; background-color: var(--c-accent); }

.brief-talk { flex-grow: 1; flex-shrink: 1; }
.brief-talk-head { flex-direction: row; align-items: flex-start; margin-bottom: 12px; }
.brief-mission { margin-top: 4px; }
.brief-tag { padding: 4px 12px; border-radius: 14px; border-width: 1px; border-color: var(--c-line-hi); color: var(--c-dim); font-size: var(--fs-15); flex-shrink: 0; }
.brief-log { max-height: 230px; overflow: hidden; justify-content: flex-end; }
.brief-log--all { max-height: none; }
.brief-past { font-size: var(--fs-18); color: #8FA6C0; margin-bottom: 8px; padding-left: 14px; border-left-width: 2px; border-color: var(--c-line); white-space: normal; }
.brief-line {
    margin-top: 6px;
    min-height: 150px;
    padding: 16px 20px;
    border-radius: 8px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--c-line-hi);
    border-left-color: var(--c-accent);
    background-color: rgba(57, 198, 244, 0.07);
}
.brief-who { font-size: var(--fs-14); letter-spacing: 3px; color: var(--c-accent); -unity-font-style: bold; margin-bottom: 8px; }
.brief-say { font-size: var(--fs-24); color: var(--c-text); white-space: normal; }
.brief-ctl { flex-direction: row; align-items: center; margin-top: 14px; }
.brief-ctl .unity-button { margin-left: 10px; font-size: var(--fs-18); padding: 10px 22px; }
.brief-dots { flex-direction: row; align-items: center; }
.brief-dot { width: 10px; height: 10px; border-radius: 5px; margin-right: 6px; background-color: var(--c-line); }
.brief-dot--done { background-color: var(--c-accent); }
.brief-dot--now { width: 26px; background-color: var(--c-accent); }
.brief-foot { margin-top: 14px; }
.brief-todo {
    flex-direction: row;
    align-items: center;
    padding: 14px 18px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--c-tight);
    background-color: rgba(255, 181, 71, 0.08);
}
.brief-todo-icon { font-size: var(--fs-38); color: var(--c-tight); margin-right: 16px; }
.brief-todo-text { flex-shrink: 1; }
.brief-todo-text .eyebrow { color: var(--c-tight); font-size: var(--fs-15); margin-bottom: 4px; }
.modal--brief .body { font-size: var(--fs-18); color: var(--c-text); }
.modal--brief .small { font-size: var(--fs-15); }
.modal--brief .eyebrow { font-size: var(--fs-15); }
.modal--brief .h2 { font-size: var(--fs-34); }
.brief-dossier { margin-top: 12px; padding: 12px 16px; border-radius: 8px; border-left-width: 4px; border-color: var(--c-line-hi); background-color: rgba(255, 255, 255, 0.03); }

/* 任務進度（MissionProgressView）：階段列 + 任務目標進度條 */
.prog { margin-bottom: 14px; padding: 12px 14px; border-radius: 6px; border-width: 1px; border-color: var(--c-line); background-color: rgba(57, 198, 244, 0.04); }
.prog-stages { flex-direction: row; align-items: flex-start; margin-bottom: 12px; }
.prog-stage { flex-grow: 1; flex-basis: 0; padding: 6px 8px; border-radius: 6px; border-width: 1px; border-color: rgba(0, 0, 0, 0); }
.prog-stage-top { flex-direction: row; align-items: center; }
.prog-dot {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 2px;
    border-color: var(--c-faint);
    color: var(--c-faint);
    font-size: var(--fs-13);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}
.prog-stage-name { margin-left: 8px; font-size: var(--fs-15); color: var(--c-faint); -unity-font-style: bold; }
.prog-stage-sub { margin: 4px 0 0 32px; font-size: var(--fs-12); color: var(--c-faint); }
.prog-stage--done .prog-dot { background-color: var(--c-go); border-color: var(--c-go); color: #03170B; }
.prog-stage--done .prog-stage-name { color: var(--c-text); }
.prog-stage--done .prog-stage-sub { color: var(--c-dim); }
.prog-stage--now { border-color: var(--c-accent); background-color: var(--c-accent-dim); }
.prog-stage--now .prog-dot { background-color: var(--c-accent); border-color: var(--c-accent); color: #04121D; }
.prog-stage--now .prog-stage-name { color: var(--c-text); }
.prog-stage--now .prog-stage-sub { color: var(--c-accent); }
.prog-link { width: 14px; height: 2px; margin-top: 18px; background-color: var(--c-line); flex-shrink: 0; }
.prog-link--done { background-color: var(--c-go); }
.prog-goals-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.prog-goals { flex-direction: row; flex-wrap: wrap; }
.prog-goal {
    width: 49%;
    margin: 0 1% 8px 0;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--c-line);
    border-left-color: var(--c-accent);
    background-color: rgba(255, 255, 255, 0.025);
}
.prog-goal--go { border-left-color: var(--c-go); }
.prog-goal--over { border-left-color: var(--c-over); }
.prog-goal-top { flex-direction: row; align-items: center; flex-wrap: wrap; }
.prog-goal-val { flex-direction: row; align-items: center; flex-shrink: 0; margin-left: auto; padding-left: 10px; }
.prog-goal-val > * { flex-shrink: 0; white-space: nowrap; }
.prog-dept { width: 10px; height: 10px; border-radius: 5px; margin-right: 8px; background-color: var(--c-accent); flex-shrink: 0; }
.prog-goal-name { font-size: var(--fs-15); -unity-font-style: bold; flex-shrink: 1; white-space: normal; }
.prog-goal-now { font-size: var(--fs-17); -unity-font-style: bold; color: var(--c-text); }
.prog-goal-target { margin-left: 5px; font-size: var(--fs-13); color: var(--c-dim); }
.prog-goal-mark { margin-left: 8px; font-size: var(--fs-16); -unity-font-style: bold; }
.prog-track { height: 8px; margin-top: 6px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.07); overflow: hidden; }
.prog-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background-color: var(--c-accent); }
.prog-fill--go { background-color: var(--c-go); }
.prog-fill--over { background-color: var(--c-over); }
.prog-goal-text { margin-top: 5px; white-space: normal; }
.dash-sec { margin-right: 12px; }
/* 影像牆上的精簡版：字放大、目標一欄一條 */
.wscreen .prog { padding: 10px 12px; margin-bottom: 10px; }
.wscreen .prog-goal { padding: 5px 10px; margin-bottom: 6px; }
.wscreen .prog-goal-name { font-size: var(--fs-17); }
.wscreen .prog-goal-now { font-size: var(--fs-18); }
.dash-wall { flex-direction: row; flex-grow: 1; align-items: flex-start; }
.dash-wall-left { width: 52%; margin-right: 2%; flex-shrink: 0; }
.dash-wall-right { flex-grow: 1; flex-shrink: 1; }
.dash-wall-left .prog { margin-bottom: 0; }
.wscreen .prog-goal { width: 100%; margin-right: 0; }
.wscreen .prog-stage { padding: 4px 2px; }
.wscreen .prog-stage-top { flex-direction: column; align-items: center; }
.wscreen .prog-stage-name { margin: 4px 0 0 0; white-space: nowrap; font-size: var(--fs-14); -unity-text-align: middle-center; }
.wscreen .prog-link { width: 6px; }
.wscreen .prog > *, .wscreen .prog-goals > *, .dash-wall-right > * { flex-shrink: 0; }

/* 儀表板 */
.dash-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.dash-lamp { width: 10px; height: 10px; border-radius: 5px; margin-right: 10px; background-color: var(--c-faint); }
.dash-lamp--go { background-color: var(--c-go); }
.dash-lamp--tight { background-color: var(--c-tight); }
.dash-lamp--over { background-color: var(--c-over); }
.dash-lamp--none { background-color: rgba(0, 0, 0, 0); }

/* 手冊（ManualPanels.cs）：章節標題列、規則卡、症狀表、步驟鏈。
   參考解析度 1920×1080；手冊字多，用自己的寬面板（modal--manual）和較大的字級。 */
.modal--manual { width: 1560px; max-width: 96%; max-height: 94%; padding: 20px 26px; }
.modal--manual .modal-head .unity-label { font-size: var(--fs-16); }
.modal--manual .small { font-size: var(--fs-16); }
.modal--manual .body { font-size: var(--fs-19); color: #B9C9DC; }
.modal--manual .h3 { font-size: var(--fs-22); }
.modal--manual .h2 { font-size: var(--fs-34); letter-spacing: 3px; }
.modal--manual .eyebrow { font-size: var(--fs-15); }
.modal--manual .faint { color: #7890AC; }

/* 章節標題列 */
.man-intro {
    margin: 4px 0 16px 0;
    padding: 12px 16px;
    border-radius: 6px;
    background-color: rgba(57, 198, 244, 0.07);
    border-left-width: 4px;
    border-color: var(--c-accent);
    color: var(--c-text);
    font-size: var(--fs-19);
}
.man-sec { margin-top: 18px; margin-bottom: 10px; }
.man-legend { margin-top: 8px; margin-bottom: 6px; }

/* 一類零件 */
.man-code {
    padding: 3px 10px;
    border-radius: 4px;
    background-color: rgba(230, 238, 248, 0.94);
    color: #0B1424;
    font-size: var(--fs-18);
    -unity-font-style: bold;
    flex-shrink: 0;
}
.man-badge {
    margin: 0 6px 4px 0;
    padding: 2px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--c-line-hi);
    font-size: var(--fs-14);
    color: var(--c-dim);
}
.man-badge--warn { border-color: var(--c-tight); color: var(--c-tight); background-color: rgba(255, 181, 71, 0.1); }

/* 規則卡、事件卡、太空天氣卡（兩欄） */
.man-rules { flex-direction: row; flex-wrap: wrap; }
.man-rule {
    width: 49%;
    margin: 0 1% 14px 0;
    padding: 14px 18px;
    border-radius: 8px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--c-line);
    border-left-color: var(--c-accent);
    background-color: rgba(255, 255, 255, 0.03);
}
.man-rule-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.man-rule-n { margin-right: 12px; color: var(--c-accent); font-size: var(--fs-24); -unity-font-style: bold; }
.man-rule-check { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 10px; }
.man-chip {
    margin: 2px 8px 2px 8px;
    padding: 3px 12px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--c-line-hi);
    background-color: rgba(57, 198, 244, 0.1);
    font-size: var(--fs-16);
    color: var(--c-text);
}
.man-chip--payload { border-color: #B58CFF; background-color: rgba(181, 140, 255, 0.16); }
.man-chip--power { border-color: var(--c-tight); background-color: rgba(255, 181, 71, 0.16); }
.man-chip--attitude { border-color: var(--c-accent); background-color: rgba(57, 198, 244, 0.16); }
.man-chip--comms { border-color: var(--c-go); background-color: rgba(61, 220, 132, 0.16); }

/* 症狀對照表 */
.man-matrix { border-width: 1px; border-color: var(--c-line); border-radius: 8px; overflow: hidden; }
.man-mx-row { flex-direction: row; align-items: center; border-bottom-width: 1px; border-color: rgba(31, 53, 80, 0.7); min-height: 52px; }
.man-mx-row--head { background-color: rgba(57, 198, 244, 0.1); min-height: 44px; }
.man-mx-row--head .unity-label { color: var(--c-dim); font-size: var(--fs-16); -unity-font-style: bold; }
.man-mx-event { width: 20%; padding: 8px 16px; -unity-font-style: bold; font-size: var(--fs-19); flex-shrink: 0; }
.man-mx-cell { flex-grow: 1; flex-basis: 0; padding: 8px 8px; align-items: center; -unity-text-align: middle-center; }
.man-mx-v { padding: 4px 12px; border-radius: 4px; font-size: var(--fs-17); -unity-font-style: bold; }
.man-mx-v--up2 { color: var(--c-over); background-color: rgba(255, 77, 94, 0.16); }
.man-mx-v--down, .man-mx-v--half { color: var(--c-tight); background-color: rgba(255, 181, 71, 0.14); }
.man-mx-v--down2 { color: var(--c-over); background-color: rgba(255, 77, 94, 0.16); }
.man-mx-v--fault { color: var(--c-over); background-color: rgba(255, 77, 94, 0.16); }
.man-mx-v--alert { color: #B58CFF; background-color: rgba(181, 140, 255, 0.16); }

/* 處置程序 */
.man-consoles { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 14px; }
.man-proc {
    margin-bottom: 14px;
    padding: 14px 18px;
    border-radius: 8px;
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--c-line);
    border-left-color: var(--c-go);
    background-color: rgba(255, 255, 255, 0.03);
}
.man-steps { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 10px; }
.man-step { flex-direction: row; align-items: center; padding: 10px 14px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.05); }
.man-step-n {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    background-color: var(--c-go);
    color: #03170B;
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    font-size: var(--fs-18);
    flex-shrink: 0;
}
.man-step-text { margin-left: 12px; align-items: flex-start; }
.man-step-name { font-size: var(--fs-19); -unity-font-style: bold; margin-bottom: 4px; }
.man-step-text .man-chip { margin-left: 0; }
.man-step-arrow { margin: 0 12px; color: var(--c-faint); font-size: var(--fs-24); }

/* 太空天氣 */
.man-storm--3 { border-left-color: var(--c-over); }
.man-storm--2 { border-left-color: var(--c-tight); }
.man-storm--1 { border-left-color: var(--c-go); }
.man-pips { flex-direction: row; margin-right: 12px; }
.man-pip { width: 10px; height: 18px; margin-right: 3px; border-radius: 2px; background-color: rgba(255, 255, 255, 0.1); }
.man-storm--3 .man-pip--on { background-color: var(--c-over); }
.man-storm--2 .man-pip--on { background-color: var(--c-tight); }
.man-storm--1 .man-pip--on { background-color: var(--c-go); }
.man-storm-meta { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 8px; }
.man-storm-meta > * { margin-right: 12px; }
.man-storm-meta .man-chip { margin-left: 0; }

/* 筆記 */
.note { margin-bottom: 10px; padding: 8px 10px; border-left-width: 2px; border-color: var(--c-line-hi); background-color: rgba(255, 255, 255, 0.02); }

/* 任務設定（選件面板）：軌道、火箭、地面站的選項 */
.mc-cols { flex-direction: row; align-items: flex-start; }
.mc-colx { flex-grow: 1; flex-basis: 0; margin-right: 16px; }
.mc-sub { margin-top: 14px; margin-bottom: 6px; }
.mc-choice {
    flex-direction: column;
    align-items: flex-start;
    margin-bottom: 6px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.03);
    border-color: var(--c-line);
    -unity-text-align: middle-left;
}
.mc-choice--on, .mc-choice--on:hover:enabled { background-color: var(--c-accent-dim); border-color: var(--c-accent); }
.mc-name { font-size: var(--fs-15); color: var(--c-text); -unity-font-style: bold; }

/* 失敗原因 */
.fail-card {
    margin-bottom: 10px;
    padding: 10px 12px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 77, 94, 0.5);
    border-left-width: 4px;
    border-left-color: var(--c-over);
    background-color: rgba(255, 77, 94, 0.06);
}
.fail-card--ok { border-color: rgba(61, 220, 132, 0.4); border-left-color: var(--c-go); background-color: rgba(61, 220, 132, 0.05); }

/* 營運 */
.ops-bar {
    position: absolute;
    left: 50%;
    top: 14px;
    translate: -50% 0;
    flex-direction: row;
    align-items: center;
    padding: 6px 16px;
    border-radius: 4px;
    background-color: rgba(6, 12, 22, 0.88);
    border-width: 1px;
    border-color: var(--c-line-hi);
}
.ops-bar > * { margin: 0 8px; }
.ops-bar-event { color: var(--c-tight); -unity-font-style: bold; }
.ops-bar-timer { color: var(--c-text); font-size: var(--fs-18); }
.judge-row, .act-row { flex-direction: row; flex-wrap: wrap; margin: 6px 0 10px 0; }
.judge-row > .unity-button, .act-row > .unity-button { margin: 0 10px 8px 0; }
.readings { margin: 6px 0 12px 0; border-width: 1px; border-color: var(--c-line); border-radius: 4px; }
.reading { flex-direction: row; align-items: center; padding: 6px 10px; border-bottom-width: 1px; border-color: rgba(31, 53, 80, 0.5); }
.reading--alert { background-color: rgba(255, 181, 71, 0.1); }
.reading--alert .reading-v { color: var(--c-tight); }
.reading-k { flex-grow: 1; color: var(--c-dim); }
.reading-v { font-size: var(--fs-16); color: var(--c-text); }
.ops-actions { margin-top: 8px; }
.ops-actions-title { margin-bottom: 6px; }
.ops-log-row { flex-direction: row; align-items: center; padding: 3px 0; }
.ops-log-row > * { margin-right: 8px; }

/* 大廳 */
.lobby-head { flex-direction: row; align-items: center; margin-bottom: 10px; }
.lobby-player { flex-direction: row; align-items: center; padding: 6px 0; border-bottom-width: 1px; border-color: rgba(31, 53, 80, 0.5); }
.lobby-player > * { margin-right: 10px; }

/* 新手訓練：左上角的任務追蹤 */
.coach {
    margin-top: 6px;
    width: 350px;
    padding: 7px 11px;
    border-radius: 6px;
    background-color: rgba(9, 16, 28, 0.72);
    border-left-width: 3px;
    border-color: var(--c-accent);
}

/* ---------- 世界螢幕（RenderTexture） ---------- */
.wscreen { background-color: #091320; }
.wscreen-body { flex-grow: 1; padding: 22px 28px; }
.wscreen-title { font-size: var(--fs-18); margin-bottom: 12px; }
.wscreen .body { font-size: var(--fs-18); }
.coach-head { flex-direction: row; align-items: center; }
.coach-count { font-size: var(--fs-12); color: var(--c-accent); margin-right: 8px; flex-shrink: 0; }
.coach-title { font-size: var(--fs-14); -unity-font-style: bold; color: var(--c-text); flex-shrink: 1; white-space: normal; }
.coach-more { font-size: var(--fs-11); color: var(--c-dim); margin-left: 8px; }
.coach-body { margin-top: 4px; font-size: var(--fs-13); color: var(--c-dim); }
.coach--done { border-color: var(--c-go); }
.coach--done .coach-title { color: var(--c-go); }
.coach-marker { position: absolute; translate: -50% -100%; align-items: center; }
.coach-marker-pin {
    width: 16px;
    height: 16px;
    rotate: 45deg;
    background-color: var(--c-accent);
    border-width: 2px;
    border-color: #E6EEF8;
}
.coach-marker-dist {
    margin-top: 6px;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: var(--fs-13);
    color: var(--c-text);
    background-color: rgba(6, 12, 22, 0.75);
}
.coach-marker--edge { translate: -50% -50%; opacity: 0.85; }

/* ---------- Go/No-Go 點名、發射條件 ---------- */
.poll {
    position: absolute;
    left: 50%;
    top: 14px;
    translate: -50% 0;
    min-width: 520px;
    max-width: 760px;
    padding: 12px 16px;
    border-radius: 6px;
    background-color: rgba(9, 16, 28, 0.95);
    border-width: 1px;
    border-color: var(--c-tight);
    border-left-width: 4px;
}
.poll--hold { border-color: var(--c-over); }
.poll-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.poll-list { flex-direction: row; flex-wrap: wrap; margin-bottom: 8px; }
.poll-cell {
    min-width: 110px;
    margin: 0 8px 6px 0;
    padding: 6px 10px;
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--c-line);
    background-color: rgba(255, 255, 255, 0.03);
}
.poll-actions { flex-direction: row; align-items: center; margin-bottom: 6px; }
.poll-actions > .unity-button { margin-left: 8px; }
.launch-gate { margin: 10px 0 4px 0; }
.gate-row { flex-direction: row; align-items: center; margin: 3px 0; }
.gate-row > .body { flex-shrink: 1; }
.launch-next { font-size: var(--fs-18); color: var(--c-dim); margin-top: 8px; letter-spacing: 1px; }

/* 野火關卡：異常判讀的長波熱紅外線欄 */
.man-mx-v--up { color: var(--c-tight); background-color: rgba(255, 181, 71, 0.14); }
.man-mx-v--flat { color: var(--c-dim); background-color: rgba(139, 163, 191, 0.12); }

/* 手冊的快查表 */
.man-qt { border-width: 1px; border-color: var(--c-line); border-radius: 8px; overflow: hidden; margin: 10px 0 16px 0; }
.man-qt > .h3 { padding: 10px 16px 6px 16px; }

.man-qt .man-mx-cell { font-size: var(--fs-19); color: var(--c-text); }

/* ---------- 手冊：翻頁的書（ManualPanel）與手冊圖表（ManualCharts.cs） ---------- */
/* 每章一個顏色：--ch。書脊、封面、標題、書籤都用它 */
.book--payload { --ch: #B58CFF; --ch-dim: rgba(181, 140, 255, 0.14); }
.book--power { --ch: #FFB847; --ch-dim: rgba(255, 184, 71, 0.14); }
.book--comms { --ch: #39C6F4; --ch-dim: rgba(57, 198, 244, 0.14); }
.book--avionics { --ch: #3DDC84; --ch-dim: rgba(61, 220, 132, 0.14); }
.book--rules { --ch: #6B9EFF; --ch-dim: rgba(107, 158, 255, 0.14); }
.book--diagnose { --ch: #FF6B73; --ch-dim: rgba(255, 107, 115, 0.14); }
.book--procedures { --ch: #FF9E42; --ch-dim: rgba(255, 158, 66, 0.14); }
.book--donki { --ch: #F268E0; --ch-dim: rgba(242, 104, 224, 0.14); }

.modal--book { height: 92%; }
.book { flex-grow: 1; flex-shrink: 1; overflow: hidden; }

.book-spread { flex-direction: row; align-items: stretch; flex-grow: 1; flex-shrink: 1; }
.book-spine {
    width: 40px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 18px;
    border-radius: 8px 0 0 8px;
    background-color: var(--ch);
}
.book-spine-num { font-size: var(--fs-24); -unity-font-style: bold; color: #08111F; }
.book-sheet {
    flex-grow: 1;
    flex-shrink: 1;
    padding: 16px 22px 12px 26px;
    border-radius: 0 8px 8px 0;
    background-color: #101C30;
    border-width: 1px;
    border-left-width: 0;
    overflow: hidden;
    border-color: rgba(255, 255, 255, 0.06);
}
.book-head { flex-shrink: 0; flex-direction: row; align-items: center; padding-bottom: 10px; margin-bottom: 10px; border-bottom-width: 2px; border-color: var(--ch); }
.book-head-ch { color: var(--ch); margin-right: 14px; }
.book-head-name { font-size: var(--fs-26); -unity-font-style: bold; color: var(--c-text); letter-spacing: 2px; }
.book .man-intro { border-color: var(--ch); background-color: var(--ch-dim); }
.book .man-rule-n { color: var(--ch); border-color: var(--ch); }

.book-page { flex-grow: 1; flex-shrink: 1; overflow: hidden; }
.book-scroll { flex-grow: 1; flex-shrink: 1; }
.book-scroll .unity-scroll-view__content-container { padding-right: 12px; }
.book-leaf {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #101C30;
    border-right-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    transform-origin: left center;
    transition-property: scale;
    transition-duration: 0.42s;
    transition-timing-function: ease-in-out-sine;
    overflow: hidden;
}
.book-leaf--turned { scale: 0.02 1; }
.book-leaf-inner { padding-right: 12px; }
.book-leaf-shade {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: #000000;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.42s;
}
.book-leaf--turned .book-leaf-shade { opacity: 0.7; }
.book-foot { flex-shrink: 0; flex-direction: row; align-items: center; margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-color: rgba(255, 255, 255, 0.08); }
.book-turn { font-size: var(--fs-17); padding: 8px 18px; border-color: var(--ch); color: var(--c-text); background-color: var(--ch-dim); }
.book-turn:hover:enabled { background-color: var(--ch); color: #08111F; border-color: var(--ch); }
.book-dots { flex-direction: row; margin-right: 14px; }
.book-dot { width: 10px; height: 10px; margin: 0 4px; border-radius: 5px; background-color: rgba(255, 255, 255, 0.15); }
.book-dot--on { background-color: var(--ch); width: 26px; }
.book-pageno { font-size: var(--fs-15); color: var(--c-dim); }
.book-cover {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    padding-left: 90px;
    border-radius: 8px;
    background-color: var(--ch);
    transform-origin: left center;
    transition-property: scale, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-in-sine;
}
.book-cover--open { scale: 0.02 1; opacity: 0.4; }
.book-cover-kicker { font-size: var(--fs-20); letter-spacing: 6px; color: rgba(8, 17, 31, 0.7); -unity-font-style: bold; }
.book-cover-num { font-size: 160px; color: #08111F; -unity-font-style: bold; margin: 0; }
.book-cover-name { font-size: 64px; color: #08111F; -unity-font-style: bold; letter-spacing: 6px; }

/* 疊在圖表上的文字（刻度） */
.mchart-text { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.mchart-tick { font-size: var(--fs-16); color: #7890AC; }

/* 軌道圓環 */
.mring-row { flex-direction: row; flex-wrap: wrap; margin: 12px 0 6px 0; }
.mring-cell { align-items: center; margin: 0 22px 12px 0; width: 190px; }
.mring { width: 170px; height: 170px; align-items: center; justify-content: center; }
.mring-mid { align-items: center; }
.mring-v { font-size: var(--fs-22); -unity-font-style: bold; color: var(--c-text); }
.mring-k { font-size: var(--fs-13); color: var(--c-dim); }
.mring-name { margin-top: 6px; font-size: var(--fs-16); -unity-font-style: bold; -unity-text-align: middle-center; white-space: normal; }
.mring-legend { flex-direction: row; align-items: center; flex-wrap: wrap; margin: 4px 0 12px 0; }
.mring-legend > .unity-label { margin-right: 18px; }
.mring-swatch { width: 14px; height: 14px; border-radius: 3px; margin-right: 8px; }
.mring-swatch--sun { background-color: #FFB847; }
.mring-swatch--shadow { background-color: #293857; }

/* 太空天氣時間軸 */
.mtime { height: 260px; margin: 6px 0 4px 0; padding: 4px; border-radius: 8px; background-color: rgba(255, 255, 255, 0.03); }

/* 名稱和括號裡的規格分兩行（ManualView.Named） */
.named { flex-direction: column; flex-shrink: 1; }
.named-main { white-space: normal; }
.named-sub { margin-top: 2px; font-size: var(--fs-15); color: var(--c-dim); -unity-font-style: normal; }

/* 大廳牆上的隊伍名單螢幕 */
.team-board { flex-grow: 1; align-items: stretch; padding: 14px 18px; }
.team-board-title { font-size: var(--fs-30); -unity-font-style: bold; letter-spacing: 3px; color: var(--c-text); }
.team-board-role { font-size: var(--fs-16); white-space: normal; color: var(--c-dim); margin: 6px 0 14px 0; }
.team-board-name { font-size: var(--fs-24); margin-top: 4px; padding: 6px 12px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.06); color: var(--c-text); }
.team-board-name--me { background-color: var(--c-accent-dim); border-width: 1px; border-color: var(--c-accent); }

/* 大廳：名單、全員就緒視窗 */
/* 房間碼：一個字一格 */
.room-code { margin-top: 6px; padding: 8px 12px; border-radius: 6px; background-color: rgba(6, 12, 22, 0.72); }
.room-code-label { font-size: var(--fs-16); letter-spacing: 2px; color: var(--c-dim); -unity-font-style: bold; }
.room-code-tiles { flex-direction: row; align-items: center; margin-top: 4px; }
.room-code-tile {
    min-width: 46px; padding: 4px 8px; margin-right: 6px; border-radius: 6px;
    border-width: 1px; border-color: var(--c-accent); background-color: var(--c-accent-dim);
    font-size: var(--fs-30); -unity-font-style: bold; -unity-text-align: middle-center; color: var(--c-text);
}
.room-code-copy { margin-left: 8px; }
.room-code-how { margin-top: 6px; font-size: var(--fs-14); color: var(--c-dim); white-space: normal; }
.lobby-mission { align-items: flex-end; }
.lobby-team { flex-grow: 1; flex-basis: 0; margin: 0 6px; padding: 10px 12px; border-radius: 6px; border-width: 1px; border-top-width: 4px; background-color: rgba(255, 255, 255, 0.04); }
.lobby-team-title { font-size: var(--fs-18); -unity-font-style: bold; letter-spacing: 2px; color: var(--c-text); margin-bottom: 6px; }
.lobby-player { padding: 4px 8px; margin-top: 3px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.05); }
.lobby-player--me { background-color: var(--c-accent-dim); }
.lobby-pname { font-size: var(--fs-16); color: var(--c-text); }
.lobby-pstate { font-size: var(--fs-14); -unity-font-style: bold; letter-spacing: 1px; }
.lobby-count { margin-top: 12px; -unity-text-align: middle-center; font-size: var(--fs-18); -unity-font-style: bold; letter-spacing: 3px; }
.go-wrap { align-items: stretch; padding: 8px 4px; }
.go-wrap > * { flex-shrink: 0; }
.go-title { font-size: var(--fs-34); -unity-font-style: bold; letter-spacing: 8px; color: #6BFF9A; -unity-text-align: middle-center; margin-bottom: 10px; }
.go-btn { margin: 26px 24px 10px 24px; padding: 18px 12px; font-size: var(--fs-30); letter-spacing: 6px; border-width: 2px; border-color: #B8FFD0; white-space: normal; }
.go-keys { flex-direction: row; align-items: center; margin-top: 22px; }
.go-keys .key-label { font-size: var(--fs-14); }
.go-keys .keycap { margin-left: 4px; }
.team-board--assembly { border-top-width: 6px; border-color: #38C6F4; }
.team-board--control { border-top-width: 6px; border-color: #FFA826; }
.team-board-name { flex-direction: row; align-items: center; }
.team-board-pn { font-size: var(--fs-24); color: var(--c-text); }

/* 營運小遊戲 */
.mini-canvas { width: 100%; height: 540px; background-color: rgb(10, 16, 24); border-width: 1px; border-color: var(--c-line-hi); border-radius: 4px; }
.mini-canvas--pass { border-color: rgb(74, 222, 128); }
.mini-canvas--fail { border-color: rgb(255, 90, 95); }
.mini-label { -unity-font-style: bold; -unity-text-align: middle-center; }
.mini-banner { position: absolute; left: 0; right: 0; top: 42%; -unity-text-align: middle-center; font-size: 56px; -unity-font-style: bold; color: rgb(220, 230, 240); background-color: rgba(0, 0, 0, 0.45); padding: 10px 0; }
.mini-stats { flex-direction: row; flex-wrap: wrap; margin-bottom: 6px; }
.mini-stat { margin-right: 24px; font-size: 16px; color: var(--c-text); }
.mini-foot { flex-direction: row; align-items: center; margin-top: 8px; }
.mini-link { margin-top: 12px; padding: 10px 12px; border-left-width: 3px; border-color: var(--c-accent); background-color: rgba(53, 208, 232, 0.07); }
.mini-gap { margin-top: 12px; }
.mini-result { margin-top: 10px; }
.mini-debug-list { margin-top: 10px; }
.mini-debug-row { flex-direction: row; align-items: center; padding: 8px 4px; border-bottom-width: 1px; border-color: var(--c-line); }

.mini-caption { font-size: 18px; -unity-font-style: bold; color: var(--c-text); margin-bottom: 6px; padding: 6px 10px; border-left-width: 4px; border-color: var(--c-accent); background-color: rgba(53, 208, 232, 0.08); }
.mini-caption--good { color: rgb(74, 222, 128); border-color: rgb(74, 222, 128); background-color: rgba(74, 222, 128, 0.08); }
.mini-caption--warn { color: rgb(255, 176, 32); border-color: rgb(255, 176, 32); background-color: rgba(255, 176, 32, 0.08); }
.mini-caption--bad { color: rgb(255, 90, 95); border-color: rgb(255, 90, 95); background-color: rgba(255, 90, 95, 0.08); }

/* ---------- 組裝單（BenchOrderView）：組裝區右上角、工作台的螢幕 ---------- */
.asm-head { flex-direction: row; align-items: center; margin-bottom: 6px; }
.asm-name { margin-left: 12px; flex-shrink: 1; }
.modal--manual .asm-name { font-size: var(--fs-24); letter-spacing: 1px; }
.ord-hud { position: absolute; right: 14px; top: 48px; width: 300px; }
.ord {
    padding: 8px 11px;
    border-radius: 6px;
    background-color: rgba(9, 16, 28, 0.74);
    border-left-width: 3px;
    border-color: var(--c-accent);
}
/* 右上角的組裝單（不是組裝台螢幕那一份）：字小一點，不擋畫面 */
.ord-hud .eyebrow { font-size: var(--fs-11); }
.ord-hud .ord-count { font-size: var(--fs-14); }
.ord-hud .ord-title { margin: 2px 0 5px 0; }
.ord-hud .ord-name { font-size: var(--fs-14); margin-left: 8px; }
.ord-hud .man-code { font-size: var(--fs-12); }
.ord-hud .ord-step { margin-top: 3px; }
.ord-hud .ord-n { width: 18px; margin-right: 6px; font-size: var(--fs-12); }
.ord-hud .ord-step-text { font-size: var(--fs-12); }
.ord-hud .ord-now { margin-top: 6px; padding: 5px 9px; }
.ord-hud .ord-role { font-size: var(--fs-15); }
.ord-hud .ord-how { margin-top: 6px; font-size: var(--fs-11); }
.ord-hud .ord-take { font-size: var(--fs-15); }
.ord-hud .ord-idle { margin-top: 4px; font-size: var(--fs-14); }
.ord-head { flex-direction: row; align-items: center; }
.ord-count { font-size: var(--fs-18); color: var(--c-accent); -unity-font-style: bold; }
.ord-title { flex-direction: row; align-items: center; margin: 4px 0 8px 0; }
.ord-name { margin-left: 10px; font-size: var(--fs-18); -unity-font-style: bold; color: var(--c-text); flex-shrink: 1; white-space: normal; }
.ord-step { flex-direction: row; align-items: center; margin-top: 5px; }
.ord-n {
    width: 24px;
    flex-shrink: 0;
    margin-right: 8px;
    font-size: var(--fs-15);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--c-dim);
}
.ord-step-text { flex-shrink: 1; font-size: var(--fs-15); color: var(--c-dim); white-space: normal; }
.ord-step--done .ord-n, .ord-step--done .ord-step-text { color: var(--c-go); }
.ord-step--done .ord-step-text { -unity-font-style: bold; }
.ord-step--later { opacity: 0.75; }
.ord-now {
    margin-top: 8px;
    padding: 8px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--c-accent);
    background-color: var(--c-accent-dim);
}
.ord-now .eyebrow { color: var(--c-accent); margin-bottom: 2px; }
.ord-role { font-size: var(--fs-20); -unity-font-style: bold; color: var(--c-text); white-space: normal; }
.ord-how { margin-top: 10px; font-size: var(--fs-14); color: var(--c-dim); white-space: normal; }
.ord-take { margin-top: 6px; font-size: var(--fs-20); -unity-font-style: bold; color: var(--c-go); white-space: normal; }
.ord-idle { margin-top: 10px; font-size: var(--fs-20); color: var(--c-dim); white-space: normal; }
/* 工作台的螢幕：要從幾步外看得到，字放得很大（固定大小，不跟字體設定：螢幕就這麼大） */
.ord--screen { flex-grow: 1; padding: 20px 26px; border-left-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); }
.ord--screen .eyebrow { font-size: 30px; }
.ord--screen .ord-count { font-size: 40px; }
.ord--screen .ord-title { margin: 6px 0 4px 0; }
.ord--screen .ord-name { font-size: 40px; }
.ord--screen .man-code { font-size: 32px; }
.ord--screen .ord-n { width: 50px; font-size: 32px; }
.ord--screen .ord-step-text { font-size: 30px; }
.ord--screen .ord-step { margin-top: 8px; }
.ord--screen .ord-now { margin-top: 12px; padding: 12px 18px; border-width: 3px; }
.ord--screen .ord-role { font-size: 52px; }
.ord--screen .ord-how { display: none; }
.ord--screen .ord-take { font-size: 56px; margin-top: 30px; }
.ord--screen .ord-idle { font-size: 52px; margin-top: 30px; }

/* 任務說明的按鍵提示（右上角）：鍵帽 + 文字 */
.brief-chip {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
    padding: 3px 10px 3px 6px;
    border-radius: 14px;
    background-color: rgba(9, 16, 28, 0.7);
    border-width: 1px;
    border-color: var(--c-line-hi);
}
.brief-chip-label { font-size: var(--fs-12); color: var(--c-text); }
.brief-again { margin-top: 10px; font-size: var(--fs-16); color: var(--c-dim); white-space: normal; }

/* ---------- 知識卡圖鑑（CodexView） ---------- */
.codex-card {
    margin-top: 14px;
    padding: 8px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--c-line);
    border-left-width: 3px;
    border-left-color: #B58CFF;
    background-color: rgba(181, 140, 255, 0.06);
}
.codex-fact { font-size: var(--fs-18); color: var(--c-text); white-space: normal; margin: 8px 0 6px 0; -unity-font-style: bold; }
.modal--manual .codex-text, .codex-text { font-size: var(--fs-16); color: #B9C9DC; white-space: normal; margin-bottom: 8px; }
.codex-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.codex-track { flex-grow: 1; height: 8px; margin-left: 16px; border-radius: 4px; background-color: rgba(31, 53, 80, 0.8); overflow: hidden; }
.codex-fill { height: 100%; background-color: #B58CFF; }
.codex-how { margin-bottom: 10px; }
.codex-wrap { flex-direction: row; align-items: stretch; height: 560px; flex-shrink: 1; overflow: hidden; }
.codex-list { width: 46%; flex-shrink: 0; margin-right: 18px; }
.codex-cat { margin: 10px 0 6px 0; letter-spacing: 2px; }
.codex-grid { flex-direction: row; flex-wrap: wrap; }
.codex-tile {
    width: 150px;
    min-height: 62px;
    margin: 0 8px 8px 0;
    padding: 6px 8px;
    flex-direction: column;
    align-items: flex-start;
    border-radius: 6px;
    border-width: 1px;
    border-top-width: 3px;
    border-color: var(--c-line-hi);
    background-color: rgba(10, 22, 40, 0.85);
}
.codex-tile:hover:enabled { border-color: var(--c-accent); background-color: rgba(57, 198, 244, 0.12); scale: 1 1; }
.codex-tile--on, .codex-tile--on:hover:enabled { border-color: var(--c-accent); background-color: var(--c-accent-dim); }
.codex-tile--locked { opacity: 0.5; border-top-color: var(--c-line); }
.codex-tile-code { font-size: var(--fs-14); color: var(--c-dim); -unity-font-style: bold; }
.codex-tile-name { font-size: var(--fs-15); color: var(--c-text); white-space: normal; margin-top: 2px; }
.codex-detail { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; margin-top: 0; padding: 14px 16px; }
.codex-detail .unity-label, .codex-detail .row { flex-shrink: 0; }
.codex-detail .asm-name { white-space: normal; }
.codex-detail-cat { margin-top: 10px; }
.codex-comp { flex-direction: row; align-items: flex-start; margin-top: 6px; padding-top: 6px; border-top-width: 1px; border-color: rgba(31, 53, 80, 0.5); }
.codex-comp-name { width: 38%; flex-shrink: 0; padding-right: 10px; font-size: var(--fs-15); color: var(--c-text); -unity-font-style: bold; white-space: normal; }
.codex-comp-role { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; font-size: var(--fs-14); color: var(--c-dim); white-space: normal; }

/* ---------- 設計圖庫（DesignsView）：上方儲存與匯入、左清單、右比較表 ---------- */
.dsg-top { flex-direction: row; align-items: stretch; margin-bottom: 6px; }
.dsg-box { flex-grow: 1; flex-basis: 0; margin-right: 16px; min-width: 0; }
.dsg-row { flex-direction: row; align-items: center; }
.dsg-field { flex-grow: 1; flex-shrink: 1; min-width: 0; margin-right: 10px; }
.dsg-msg { margin: 2px 0 6px 0; }
.dsg-wrap { flex-direction: row; align-items: stretch; height: 520px; flex-shrink: 1; overflow: hidden; margin-top: 6px; }
.dsg-list-col { width: 42%; flex-shrink: 0; margin-right: 18px; }
.dsg-list { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 8px; }
.dsg-empty { margin: 12px 4px; white-space: normal; }
.dsg-item {
    margin: 0 6px 8px 0;
    padding: 10px 12px;
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--c-line);
    background-color: rgba(10, 18, 32, 0.6);
}
.dsg-item--on { border-color: var(--c-accent); background-color: rgba(57, 198, 244, 0.07); }
.dsg-item .dim { color: #A9BBD0; }
.dsg-item .faint { color: #7890AC; }
.dsg-item--current { border-left-width: 3px; border-left-color: var(--c-go); }
.dsg-item-head { flex-direction: row; align-items: center; }
.dsg-item-name { font-size: var(--fs-18); -unity-font-style: bold; color: var(--c-text); flex-shrink: 1; }
.dsg-grade { font-size: var(--fs-17); color: var(--c-go); -unity-font-style: bold; }
.dsg-grade--fail { color: var(--c-over); }
.dsg-codes { margin-top: 2px; white-space: normal; }
.dsg-acts { flex-direction: row; align-items: center; flex-wrap: wrap; margin-top: 8px; }
.dsg-acts > .chip { margin: 0 8px 0 0; color: var(--c-text); }
.dsg-acts > .dsg-del { color: var(--c-dim); }
.dsg-row > .unity-button { margin-left: 10px; flex-shrink: 0; }
.chip--go, .chip--go:hover:enabled { border-color: var(--c-go); color: var(--c-go); }
.chip--danger, .chip--danger:hover:enabled { border-color: var(--c-over); color: var(--c-over); }
.dsg-cmp-col { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; }
.dsg-cmp-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; margin-top: 8px; }
.dsg-note { margin-top: 8px; }
.cmp-table { border-width: 1px; border-color: var(--c-line); border-radius: 8px; overflow: hidden; }
.cmp-row { flex-direction: row; align-items: stretch; border-bottom-width: 1px; border-color: rgba(31, 53, 80, 0.6); }
.cmp-row--head { background-color: rgba(57, 198, 244, 0.08); }
.cmp-k { width: 176px; flex-shrink: 0; padding: 8px 10px; font-size: var(--fs-16); color: var(--c-dim); -unity-text-align: middle-left; }
.cmp-cell { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 6px 10px; border-left-width: 1px; border-color: rgba(31, 53, 80, 0.6); }
.cmp-cell--best { background-color: rgba(61, 220, 132, 0.10); }
.cmp-cell--best .cmp-v { color: var(--c-go); }
.cmp-cell--tight .cmp-v { color: var(--c-tight); }
.cmp-cell--over { background-color: rgba(255, 77, 94, 0.12); }
.cmp-cell--over .cmp-v { color: var(--c-over); }
.cmp-name { font-size: var(--fs-17); -unity-font-style: bold; color: var(--c-text); white-space: normal; }
.cmp-v { font-size: var(--fs-17); color: var(--c-text); }

/* 主選單：半寬的並排項目、蓋滿畫面的寬版頁面（設計圖庫、圖鑑） */
.menu-pair { flex-direction: row; align-items: stretch; }
.menu-item--half { flex-grow: 1; flex-basis: 0; min-width: 0; }
.menu-item--half.menu-item--left { margin-right: 10px; }
.menu-col--full { left: 40px; right: 40px; top: 64px; bottom: 24px; width: auto; max-height: none; padding: 18px 26px; background-color: rgba(4, 8, 16, 0.985); }
.menu-intro { margin: 2px 0 10px 0; font-size: var(--fs-15); }
.menu-col--full .dsg-wrap, .menu-col--full .codex-wrap { flex-grow: 1; height: auto; min-height: 0; }
.menu-col--full .small { font-size: var(--fs-15); }
.menu-col--full .body { font-size: var(--fs-17); }
.report-save { margin-left: 14px; }

/* 知識卡精通（組裝時一次都沒裝錯） */
.codex-master-count { margin-left: 14px; font-size: var(--fs-17); -unity-font-style: bold; color: #FFC94A; }
.codex-tile-code--master { color: #FFC94A; }
.codex-master { margin: 4px 0; font-size: var(--fs-15); -unity-font-style: bold; color: #FFC94A; white-space: normal; }
.codex-master-how { margin: 4px 0; white-space: normal; }
.brief-chip .keycap { min-width: 20px; font-size: var(--fs-12); -unity-text-align: middle-center; }

/* ====================================================================
   選件（設計主螢幕）、挖空的數值、線索、組裝清單、流程說明
   ==================================================================== */

/* ---------- 選件面板（中控室的設計主螢幕按 E） ---------- */
.modal--select { width: 1640px; max-width: 97%; height: 94%; max-height: 94%; padding: 18px 24px; }
.modal--select .small { font-size: var(--fs-14); }
.modal--select .eyebrow { font-size: var(--fs-14); }
.modal--select .body { font-size: var(--fs-16); }
.modal--select .faint { color: #7890AC; }
.sel-cols { flex-direction: row; flex-grow: 1; flex-shrink: 1; align-items: stretch; }
.sel-left { flex-grow: 1.45; flex-basis: 0; margin-right: 20px; }
.sel-right { flex-grow: 1; flex-basis: 0; padding-left: 20px; border-left-width: 1px; border-color: var(--c-line); }
.sel-scroll { flex-grow: 1; flex-shrink: 1; }
.sel-confirmed-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.sel-confirmed-body { white-space: normal; margin-bottom: 10px; }
.sel-cats { flex-direction: row; flex-wrap: wrap; margin-bottom: 4px; }
.sel-cat { margin: 0 6px 6px 0; }
.sel-blank-hint { margin-bottom: 8px; }
.sel-part {
    margin: 0 6px 8px 0;
    padding: 8px 12px;
    border-radius: 6px;
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--c-line);
    background-color: rgba(255, 255, 255, 0.025);
}
.sel-part--on { border-color: var(--c-accent); background-color: var(--c-accent-dim); }
.sel-part-top { flex-direction: row; align-items: center; }
.sel-tick, .sel-tick:hover:enabled {
    width: 30px;
    height: 30px;
    min-width: 30px;
    padding: 0;
    margin: 0 12px 0 0;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--c-line-hi);
    background-color: rgba(0, 0, 0, 0.3);
    color: #04121D;
    font-size: var(--fs-18);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    scale: 1 1;
}
.sel-tick:hover:enabled { border-color: var(--c-accent); background-color: rgba(57, 198, 244, 0.22); }
/* 單選的那一類：選中的那顆不能再點（只能換），但不要跟著變淡 */
.sel-tick--on, .sel-tick--on:hover:enabled, .sel-tick--on:disabled { background-color: var(--c-accent); border-color: #8BE3FF; opacity: 1; }
.sel-part-name { margin-left: 10px; font-size: var(--fs-17); -unity-font-style: bold; color: var(--c-text); flex-shrink: 1; white-space: normal; }
.sel-price { margin-right: 8px; font-size: var(--fs-16); color: var(--c-dim); }
.sel-more, .sel-more:hover:enabled {
    width: 30px;
    height: 30px;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: var(--c-dim);
    font-size: var(--fs-16);
    -unity-text-align: middle-center;
}
.sel-more:hover:enabled { color: var(--c-text); background-color: rgba(255, 255, 255, 0.06); }
.sel-cells { flex-direction: row; flex-wrap: wrap; margin: 6px 0 0 42px; }
.sel-cell { min-width: 136px; margin: 0 14px 4px 0; }
.sel-cell-k { font-size: var(--fs-12); color: var(--c-dim); }
.sel-cell-line { flex-direction: row; align-items: center; min-height: 30px; }
.sel-cell-v { font-size: var(--fs-17); color: var(--c-text); -unity-font-style: bold; }
.sel-cell-u { margin-left: 5px; font-size: var(--fs-12); color: var(--c-faint); }
/* 挖空的一格：自己輸入的數值。還沒填的是琥珀色的框，填了變回一般的框 */
.sel-input { width: 100px; margin: 0; }
.sel-input > .unity-text-field__input, .sel-input .unity-base-text-field__input {
    background-color: rgba(4, 10, 20, 0.9);
    border-color: var(--c-accent);
    border-radius: 4px;
    color: var(--c-text);
    font-size: var(--fs-17);
    -unity-font-style: bold;
    padding: 3px 8px;
}
.sel-input--empty > .unity-text-field__input, .sel-input--empty .unity-base-text-field__input {
    border-color: var(--c-tight);
    background-color: rgba(255, 181, 71, 0.12);
}
.sel-by { font-size: var(--fs-11); color: var(--c-accent); }
.sel-info { margin: 8px 0 2px 42px; padding: 8px 10px; border-left-width: 2px; border-color: var(--c-line-hi); background-color: rgba(0, 0, 0, 0.22); }
.sel-info-func { color: var(--c-text); }
.sel-info-stats { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 6px 0; }
.sel-stat { margin-right: 18px; }
.sel-info-stats .man-badge { margin-right: 8px; }
.sel-info-desc { white-space: normal; }
.sel-info > .small { white-space: normal; }
.sel-confirm { flex-shrink: 0; margin-top: 10px; padding-top: 10px; border-top-width: 1px; border-color: var(--c-line); align-items: stretch; }
.sel-confirm > .unity-label { white-space: normal; margin-bottom: 8px; }
.sel-confirm-btn { -unity-text-align: middle-center; }

/* ---------- 儀表板（用玩家填的數值算；沒填的顯示「資料不足」） ---------- */
.sd-note { margin-bottom: 8px; white-space: normal; }
.sd-row {
    margin: 0 6px 6px 0;
    padding: 7px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--c-line);
    background-color: rgba(255, 255, 255, 0.025);
}
.sd-row--tight { border-color: rgba(255, 181, 71, 0.55); }
.sd-row--over { border-color: var(--c-over); background-color: rgba(255, 77, 94, 0.1); }
.sd-row--unknown { border-color: rgba(255, 181, 71, 0.4); }
.sd-top { flex-direction: row; align-items: center; }
.sd-k { font-size: var(--fs-16); -unity-font-style: bold; color: var(--c-text); }
.sd-v { font-size: var(--fs-17); -unity-font-style: bold; color: var(--c-text); }
.sd-v.over { color: var(--c-over); }
.sd-v--unknown { font-size: var(--fs-15); color: var(--c-tight); }
.sd-x { margin-top: 3px; white-space: normal; }
.sd-sub { margin: -2px 6px 6px 10px; white-space: normal; }
.sd-track { height: 7px; margin-top: 5px; border-radius: 4px; background-color: rgba(255, 255, 255, 0.07); overflow: hidden; }
.sd-fill { position: absolute; left: 0; top: 0; bottom: 0; border-radius: 4px; background-color: var(--c-accent); }
.sd-fill--go { background-color: var(--c-go); }
.sd-fill--tight { background-color: var(--c-tight); }
.sd-fill--over { background-color: var(--c-over); }
.sd-foot { margin-top: 4px; white-space: normal; }
/* 牆上的設計主螢幕：一列一行，不放說明，才排得下 */
.wscreen .sd-row { margin: 0 0 4px 0; padding: 3px 9px; }
.wscreen .sd-k { font-size: var(--fs-16); }
.wscreen .sd-v { font-size: var(--fs-17); }
.wscreen .sd-x, .wscreen .sd-sub { display: none; }
.wscreen .sd-track { height: 4px; margin-top: 2px; }
.prog--compact { padding: 8px 10px; margin-bottom: 10px; }

/* ---------- 任務需求 ---------- */
.prog-goal--unknown { border-left-color: var(--c-tight); }
.prog-goal--neutral { border-left-color: var(--c-line-hi); }
.req-tag {
    margin-left: 8px;
    padding: 1px 7px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--c-tight);
    color: var(--c-tight);
    font-size: var(--fs-11);
    -unity-font-style: bold;
    letter-spacing: 1px;
    flex-shrink: 0;
}
.req-note { margin: 2px 0 10px 0; white-space: normal; }
.req-notes-title { margin: 14px 0 8px 0; }
.req-notecard { margin-right: 6px; }
.req-note-head { flex-direction: row; align-items: center; margin-bottom: 4px; }
.req-note-title { font-size: var(--fs-16); -unity-font-style: bold; color: var(--c-text); flex-shrink: 1; white-space: normal; }
.req-dot--mission_lead { background-color: #39C6F4; }
.req-dot--budget_office { background-color: #FFB547; }
.req-dot--science { background-color: #B58CFF; }
.req-dot--engineering { background-color: #3DDC84; }
.req-dot--comms { background-color: #FF8AC2; }
.wscreen .req-tag { font-size: var(--fs-13); }

/* ---------- 目前的設計（設計主螢幕左半） ---------- */
.pick-row { flex-direction: row; flex-wrap: wrap; align-items: flex-start; padding: 3px 0; border-bottom-width: 1px; border-color: rgba(31, 53, 80, 0.5); }
.pick-k { width: 108px; flex-shrink: 0; font-size: var(--fs-13); color: var(--c-dim); }
.pick-v { margin-right: 12px; font-size: var(--fs-15); color: var(--c-text); flex-shrink: 1; white-space: normal; }
.pick-v.tight { color: var(--c-tight); }
.pick-grid { margin: 6px 0 8px 0; }

/* ---------- 組裝清單：每個零件要用哪些小零件 ---------- */
.asm-list { flex-direction: row; flex-wrap: wrap; }
.asm-card {
    width: 49%;
    margin: 0 1% 8px 0;
    padding: 8px 10px;
    border-radius: 6px;
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--c-line);
    border-left-color: var(--c-tight);
    background-color: rgba(255, 255, 255, 0.025);
}
.asm-card--installed, .asm-card--ready { border-left-color: var(--c-go); opacity: 0.7; }
.asm-card--built, .asm-card--carried { border-left-color: var(--c-accent); }
.asm-card--building { border-left-color: var(--c-accent); background-color: var(--c-accent-dim); }
.asm-card-top { flex-direction: row; align-items: center; }
.asm-card .man-code { padding: 1px 7px; font-size: var(--fs-14); }
.asm-card-name { margin-left: 8px; font-size: var(--fs-15); -unity-font-style: bold; color: var(--c-text); flex-shrink: 1; white-space: normal; }
.asm-state { margin-left: 6px; font-size: var(--fs-11); -unity-font-style: bold; letter-spacing: 1px; color: var(--c-tight); flex-shrink: 0; white-space: nowrap; }
.asm-state--installed, .asm-state--ready { color: var(--c-go); }
.asm-state--built, .asm-state--carried, .asm-state--building { color: var(--c-accent); }
.asm-comps { flex-direction: row; flex-wrap: wrap; margin-top: 6px; }
.asm-comp {
    margin: 0 6px 4px 0;
    padding: 2px 8px;
    border-radius: 3px;
    border-width: 1px;
    border-color: var(--c-line-hi);
    background-color: rgba(0, 0, 0, 0.25);
    font-size: var(--fs-13);
    color: var(--c-text);
}
/* 牆上的螢幕：裝好的、不用組裝的只留一行 */
.asm-list--compact .asm-card { margin-bottom: 5px; padding: 4px 8px; }
.asm-list--compact .asm-card--installed .asm-comps, .asm-list--compact .asm-card--ready .asm-comps, .asm-list--compact .asm-card > .small { display: none; }
.asm-list--compact .asm-comps { margin-top: 3px; }
.asm-list--compact .asm-comp { margin-bottom: 2px; padding: 1px 6px; }
.bay-wait { flex-grow: 1; align-items: center; justify-content: center; padding: 40px 20px; }
.bay-wait .h2, .bay-wait.h3 { white-space: normal; -unity-text-align: middle-center; }
.bay-wait .body { margin-top: 12px; -unity-text-align: middle-center; }
.wscreen .bay-wait .h2 { font-size: 44px; letter-spacing: 3px; }
.wscreen .bay-wait .body { font-size: var(--fs-24); }

/* ---------- 組裝台左側的狀態 ---------- */
.ord-status { margin-top: 8px; font-size: var(--fs-18); -unity-font-style: bold; color: var(--c-text); white-space: normal; }
.ord-status--bad { color: var(--c-over); }
.ord-status--wait { color: var(--c-tight); }
.ord--screen .ord-status { margin-top: 26px; font-size: 46px; }

/* ---------- 流程說明（設計主螢幕右側） ---------- */
.howto-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding: 12px 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: var(--c-line);
    background-color: rgba(255, 255, 255, 0.025);
}
.howto-row--now { border-color: var(--c-accent); background-color: var(--c-accent-dim); }
.howto-row--done { opacity: 0.6; }
.howto-n { width: 46px; flex-shrink: 0; font-size: var(--fs-30); -unity-font-style: bold; color: var(--c-accent); -unity-text-align: middle-center; }
.howto-row--done .howto-n { color: var(--c-go); }
.howto-text { margin-left: 10px; font-size: var(--fs-24); color: var(--c-text); flex-shrink: 1; white-space: normal; }

/* ---------- 大廳：所有人一張名單 ---------- */
.lobby-team--roster { flex-grow: 0; flex-shrink: 0; flex-basis: auto; margin: 12px 0 8px 0; border-color: var(--c-accent); }

/* ---------- 線索（放大看；只有自己看得到） ---------- */
.modal--clue { width: 880px; max-width: 94%; --ch: var(--c-accent); --ch-dim: var(--c-accent-dim); }
.clue { min-height: 380px; padding: 28px 34px; border-radius: 3px; border-width: 1px; --ink: #1E2433; --ink-soft: rgba(30, 36, 51, 0.18); color: var(--ink); }
.clue--paper { background-color: #EFE9D6; border-color: #C9C0A4; }
.clue--book { background-color: #F4EEDF; border-color: #B8A988; border-left-width: 10px; border-left-color: #6B4A2F; }
.clue--whiteboard { background-color: #F3F5F7; border-color: #AEB7C2; border-width: 6px; --ink: #17324F; --ink-soft: rgba(23, 50, 79, 0.16); }
.clue--blackboard { background-color: #17382B; border-color: #6B4A2F; border-width: 8px; --ink: #E6EBE1; --ink-soft: rgba(230, 235, 225, 0.22); }
.clue--blueprint { background-color: #0F3B7C; border-color: #C8DCFF; border-width: 2px; --ink: #DDEBFF; --ink-soft: rgba(221, 235, 255, 0.24); }
.clue .unity-label { color: var(--ink); }
.clue-trivia-head { margin: 24px 10px 0 10px; font-size: var(--fs-15); letter-spacing: 3px; -unity-font-style: bold; -unity-text-align: middle-center; opacity: 0.7; }
.clue-trivia { margin: 28px 10px 40px 10px; font-size: var(--fs-24); white-space: normal; -unity-text-align: middle-center; }
.clue-foot { margin-top: 10px; white-space: normal; color: var(--c-dim); }
.clue-nav { flex-direction: row; align-items: center; margin-top: 10px; }
.clue-kicker { font-size: var(--fs-14); -unity-font-style: bold; letter-spacing: 4px; opacity: 0.7; }
.clue-title { margin-top: 4px; font-size: var(--fs-30); -unity-font-style: bold; white-space: normal; }
.clue-sub { font-size: var(--fs-15); opacity: 0.7; }
.clue-small { margin-top: 12px; font-size: var(--fs-14); opacity: 0.7; white-space: normal; }
.clue-sign { -unity-text-align: middle-right; }
.clue-note { margin: 16px 0 6px 0; font-size: var(--fs-24); white-space: normal; }
/* 規格表 */
.clue-table { margin-top: 16px; border-width: 2px; border-color: var(--ink); }
.clue-tr { flex-direction: row; align-items: center; padding: 9px 14px; border-bottom-width: 1px; border-color: var(--ink-soft); }
.clue-td { font-size: var(--fs-22); }
.clue-td--k { flex-grow: 1; flex-shrink: 1; white-space: normal; }
.clue-td--v { min-width: 150px; -unity-font-style: bold; -unity-text-align: middle-right; }
.clue-td--u { width: 96px; flex-shrink: 0; margin-left: 10px; font-size: var(--fs-16); opacity: 0.75; }
/* 圖表：長條的末端對到的刻度就是數值 */
.clue-bar { margin-top: 18px; }
.clue-bar-k { font-size: var(--fs-18); -unity-font-style: bold; margin-bottom: 4px; }
.clue-bar-track { height: 30px; border-width: 2px; border-color: var(--ink); background-color: var(--ink-soft); }
.clue-bar-fill { position: absolute; left: 0; top: 0; bottom: 0; background-color: var(--ink); opacity: 0.55; }
.clue-bar-grid { position: absolute; top: 0; bottom: 0; width: 1px; background-color: var(--ink); opacity: 0.35; }
.clue-bar-axis { height: 34px; }
.clue-bar-tick { position: absolute; top: 4px; font-size: var(--fs-14); opacity: 0.7; }
.clue-bar-mark { position: absolute; top: 0; width: 2px; height: 9px; margin-left: -1px; background-color: var(--ink); }
.clue-bar-value { position: absolute; top: 8px; left: -60px; width: 122px; font-size: var(--fs-18); -unity-font-style: bold; -unity-text-align: upper-center; }
/* 設計圖：中間是零件的外框，上、右、下各一條尺寸標註 */
.clue-plan { height: 330px; margin-top: 14px; }
.clue-shape {
    position: absolute;
    left: 30%;
    top: 30%;
    width: 40%;
    height: 40%;
    align-items: center;
    justify-content: center;
    border-width: 3px;
    border-color: var(--ink);
    border-radius: 6px;
    background-color: var(--ink-soft);
}
.clue-shape--solar { top: 36%; height: 28%; border-radius: 0; }
.clue-shape--battery { border-radius: 16px; }
.clue-shape--antenna { border-top-left-radius: 120px; border-top-right-radius: 120px; }
.clue-shape--adcs { border-radius: 60px; }
.clue-shape--propulsion { border-bottom-left-radius: 70px; border-bottom-right-radius: 70px; }
.clue-shape--shielding { border-width: 8px; }
.clue-shape-code { font-size: var(--fs-26); -unity-font-style: bold; letter-spacing: 2px; }
.clue-call { position: absolute; align-items: center; }
.clue-call--top { left: 30%; width: 40%; top: 2%; flex-direction: column-reverse; }
.clue-call--bottom { left: 30%; width: 40%; top: 74%; flex-direction: column; }
.clue-call--right { left: 73%; top: 30%; height: 40%; flex-direction: column; align-items: flex-start; justify-content: center; padding-left: 14px; border-left-width: 2px; border-color: var(--ink); }
.clue-call-line { width: 100%; height: 2px; margin: 5px 0; background-color: var(--ink); }
.clue-call--right .clue-call-line { display: none; }
.clue-call-k { font-size: var(--fs-15); opacity: 0.8; }
.clue-call-v { font-size: var(--fs-22); -unity-font-style: bold; }

/* ---------- 牆上的螢幕：字要夠大，站在十公尺外也看得清楚（每一面的 class 是 ws-<id>） ---------- */
/* 組裝區儀表板（6.6 × 4.1 公尺）和設計主螢幕上的組裝清單 */
.wscreen .asm-card { margin-bottom: 7px; padding: 6px 10px; }
.wscreen .asm-card .man-code { font-size: var(--fs-17); }
.wscreen .asm-card-name { font-size: var(--fs-20); }
.wscreen .asm-state { font-size: var(--fs-14); }
.wscreen .asm-comp { padding: 2px 9px; font-size: var(--fs-17); }
.wscreen .dash-head .eyebrow, .wscreen .dash-head .small { font-size: var(--fs-18); }
/* 前方的設計主螢幕（8.8 × 5 公尺，1024 × 576） */
.ws-bigscreen .wscreen-title { display: none; }
.ws-bigscreen .eyebrow { font-size: var(--fs-16); }
.ws-bigscreen .small { font-size: var(--fs-16); }
.ws-bigscreen .prog-stage-name { font-size: var(--fs-17); }
.ws-bigscreen .sd-row { margin-bottom: 3px; padding: 2px 9px; }
.ws-bigscreen .sd-k, .ws-bigscreen .sd-v { font-size: var(--fs-20); }
.ws-bigscreen .sd-v--unknown { font-size: var(--fs-17); }
.ws-bigscreen .sd-track { display: none; }
.ws-bigscreen .pick-row { padding: 4px 0; }
.ws-bigscreen .pick-k { width: 176px; font-size: var(--fs-16); }
.ws-bigscreen .pick-v { font-size: var(--fs-19); }
.ws-bigscreen .asm-card { width: 32.3%; margin-bottom: 5px; padding: 4px 8px; }
.ws-bigscreen .asm-card-name { font-size: var(--fs-18); }
.ws-bigscreen .asm-card .man-code { font-size: var(--fs-15); }
.ws-bigscreen .asm-comp { padding: 1px 7px; font-size: var(--fs-15); }
.ws-bigscreen .asm-list--many .asm-card-name { font-size: var(--fs-16); }
.ws-bigscreen .asm-list--many .asm-comp { font-size: var(--fs-14); }
.ws-bigscreen .bay-wait .h2 { font-size: var(--fs-38); }
/* 組裝區儀表板：在架子前（十幾公尺外）也要看得到要拿哪些小零件 */
.ws-bay .wscreen-title { font-size: var(--fs-22); }
.ws-bay .dash-head .eyebrow, .ws-bay .dash-head .small { font-size: var(--fs-22); }
.ws-bay .asm-card { padding: 7px 12px; }
.ws-bay .asm-card .man-code { font-size: var(--fs-20); }
.ws-bay .asm-card-name { font-size: var(--fs-24); }
.ws-bay .asm-state { font-size: var(--fs-16); }
.ws-bay .asm-comp { padding: 2px 10px; font-size: var(--fs-20); }
.ws-bay .asm-list--many .asm-card { margin-bottom: 5px; padding: 4px 10px; }
.ws-bay .asm-list--many .asm-card-name { font-size: var(--fs-20); }
.ws-bay .asm-list--many .asm-card .man-code { font-size: var(--fs-17); }
.ws-bay .asm-list--many .asm-comp { font-size: var(--fs-17); }
/* 設計主螢幕兩側（4.5 × 5 公尺的直式螢幕，1024 × 1136）：任務需求、流程說明／失敗原因；營運時是遙測 */
.ws-wall_reqs .eyebrow, .ws-wall_asm .eyebrow, .ws-wall_reqs .wscreen-title, .ws-wall_asm .wscreen-title { font-size: var(--fs-26); }
.ws-wall_reqs .small, .ws-wall_asm .small { font-size: var(--fs-20); }
.ws-wall_reqs .prog-goals-head { margin-bottom: 14px; }
.ws-wall_reqs .prog-goal { margin-bottom: 14px; padding: 18px 22px; border-left-width: 8px; }
.ws-wall_reqs .prog-dept { width: 20px; height: 20px; border-radius: 10px; margin-right: 14px; }
.ws-wall_reqs .prog-goal-name { font-size: var(--fs-38); }
.ws-wall_reqs .prog-goal-now { font-size: var(--fs-38); }
.ws-wall_reqs .prog-goal-target { font-size: var(--fs-26); }
.ws-wall_reqs .prog-goal-mark { font-size: var(--fs-38); }
.ws-wall_reqs .prog-track { height: 14px; margin-top: 12px; border-radius: 7px; }
.ws-wall_reqs .req-tag { font-size: var(--fs-20); }
.ws-wall_asm .fail-card { margin-bottom: 16px; padding: 16px 18px; }
.ws-wall_asm .body { font-size: var(--fs-24); }
.ws-wall_asm .chain-step { max-width: 420px; font-size: var(--fs-22); }
.ws-wall_asm .chain-arrow { font-size: var(--fs-26); }
.ws-wall_asm .howto-row { margin-bottom: 16px; padding: 22px 20px; }
.ws-wall_asm .howto-n { width: 70px; font-size: var(--fs-38); }
.ws-wall_asm .howto-text { font-size: var(--fs-34); }
.ws-wall_reqs .reading, .ws-wall_asm .reading { padding: 10px 6px; }
.ws-wall_reqs .reading-k, .ws-wall_asm .reading-k { font-size: var(--fs-26); }
.ws-wall_reqs .reading-v, .ws-wall_asm .reading-v { font-size: var(--fs-30); }
.ws-wall_reqs .readings, .ws-wall_asm .readings { margin-bottom: 26px; }

/* ---------- 通關條件（營運指揮台、處置小遊戲）：要一眼看得到 ---------- */
.goalbar {
    margin: 8px 0 10px 0;
    padding: 12px 16px;
    border-radius: 8px;
    border-width: 2px;
    border-color: #FFC94A;
    background-color: rgba(255, 201, 74, 0.10);
    flex-shrink: 0;
}
.goalbar-k { font-size: var(--fs-13); letter-spacing: 3px; -unity-font-style: bold; color: #FFC94A; margin-bottom: 4px; }
.goalbar-v { font-size: var(--fs-24); -unity-font-style: bold; color: var(--c-text); white-space: normal; }
.goalbar-foot { flex-direction: row; flex-wrap: wrap; align-items: center; margin-top: 8px; }
.goalbar-rule { font-size: var(--fs-15); color: var(--c-text); white-space: normal; margin-right: 18px; flex-shrink: 1; }
.goalbar-warn { color: var(--c-tight); -unity-font-style: bold; }
.goalline {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
    padding: 7px 12px;
    border-radius: 6px;
    border-left-width: 4px;
    border-color: #FFC94A;
    background-color: rgba(255, 201, 74, 0.10);
    flex-shrink: 0;
}
.goalline-k { font-size: var(--fs-13); letter-spacing: 2px; -unity-font-style: bold; color: #FFC94A; margin-right: 12px; flex-shrink: 0; }
.goalline-v { font-size: var(--fs-19); -unity-font-style: bold; color: var(--c-text); white-space: normal; flex-shrink: 1; }
.turn-goal {
    margin: 8px 0 12px 0;
    padding: 10px 14px;
    border-radius: 8px;
    border-left-width: 4px;
    border-color: #FFC94A;
    background-color: rgba(255, 201, 74, 0.08);
    flex-shrink: 0;
}
.turn-goal-steps { flex-direction: row; flex-wrap: wrap; align-items: center; }
.turn-goal-step { font-size: var(--fs-18); -unity-font-style: bold; color: var(--c-text); margin-right: 26px; white-space: normal; }
.turn-goal-step--done { color: var(--c-go); }
